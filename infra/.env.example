# Copy to infra/.env (git-ignored). Read only by infra/scripts/create-secrets.sh and create-admin.sh.
# This file is read by bash: put values with spaces or < > inside single quotes. Never commit infra/.env.
# Leave empty to use Cloudflare's public test key (always passes)
TURNSTILE_SECRET_KEY=
# First administrator (used by infra/scripts/create-admin.sh)
ADMIN_NAME='Product Team Admin'
ADMIN_EMAIL=
ADMIN_PASSWORD=

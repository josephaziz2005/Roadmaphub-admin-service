{
  "name": "roadhub-admin-service",
  "version": "1.0.0",
  "private": true,
  "description": "RoadmapHub Administration and Triage Service (S3): accounts, logins, duplicate merge/undo, moderation. Owner: Joseph Maged Aziz (240028)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "setup:tables": "bash infra/scripts/create-tables.sh",
    "setup:secrets": "bash infra/scripts/create-secrets.sh",
    "setup:sns": "bash infra/scripts/create-sns.sh",
    "setup:monitoring": "bash infra/scripts/create-monitoring.sh",
    "setup:events": "bash infra/scripts/create-eventbridge.sh",
    "create-admin": "bash infra/scripts/create-admin.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.700.0",
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-eventbridge": "^3.700.0",
    "@aws-sdk/client-secrets-manager": "^3.700.0",
    "@aws-sdk/client-sns": "^3.700.0",
    "@aws-sdk/client-sqs": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2"
  }
}
